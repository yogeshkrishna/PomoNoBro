<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PomoNoBro" Width="1120" Height="780" MinWidth="800" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F5F6F0"
        FontFamily="Segoe UI" FontSize="14" Foreground="#1B3027"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1B3027"/>
        <SolidColorBrush x:Key="Muted" Color="#53675C"/>
        <SolidColorBrush x:Key="Line" Color="#DCE5DB"/>
        <SolidColorBrush x:Key="Green" Color="#285643"/>
        <SolidColorBrush x:Key="Mist" Color="#E9F1E6"/>
        <SolidColorBrush x:Key="Mint" Color="#C4E8B7"/>
        <SolidColorBrush x:Key="Cream" Color="#F3F8EE"/>
        <SolidColorBrush x:Key="SoftWhite" Color="#BDD0C4"/>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="39"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Quiet" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FEFFFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="25"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Green}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#86A398"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#789E79"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.68"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="15,0"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Selected">
                    <Setter Property="Foreground" Value="{StaticResource Green}"/>
                    <Setter Property="Background" Value="{StaticResource Mist}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Mode" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource SoftWhite}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Selected">
                    <Setter Property="Foreground" Value="{StaticResource Cream}"/>
                    <Setter Property="Background" Value="#426255"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#F8FAF5"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#648971"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScenarioSelect" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#F8FAF5"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" Foreground="{TemplateBinding Foreground}"
                                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="SelectBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"
                                                Padding="11,0">
                                            <Grid>
                                                <ContentPresenter VerticalAlignment="Center" Margin="0,0,22,0"/>
                                                <Path Data="M 1,1 L 6,6 L 11,1" StrokeThickness="1.5"
                                                      Stroke="{StaticResource Muted}" StrokeLineJoin="Round"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SelectBorder" Property="BorderBrush" Value="#648971"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                                <Border Background="#FEFFFB" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="8" Padding="4" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="9,7"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#FEFFFB" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1">
            <Grid Height="72" Margin="36,0" MaxWidth="1140">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Green}" Width="36" Height="36" CornerRadius="11">
                        <Grid Width="22" Height="22">
                            <Ellipse Width="17" Height="17" Stroke="{StaticResource Mint}" StrokeThickness="1.5"
                                     VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                            <Path Data="M 11,7 L 11,12 L 14,14 M 8.5,1 L 13.5,1"
                                  Stroke="{StaticResource Mint}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="PomoNoBro" FontSize="21" FontWeight="SemiBold"
                               Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NavFocus" Content="Focus" Style="{StaticResource Nav}" Margin="0,0,4,0"/>
                    <Button x:Name="NavShowcase" Content="Showcase" Style="{StaticResource Nav}" Margin="0,0,4,0"/>
                    <Button x:Name="NavHistory" Content="History" Style="{StaticResource Nav}"/>
                </StackPanel>

                <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="15" Padding="11,5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#578363" Margin="0,0,7,0"/>
                        <TextBlock Text="Offline" Foreground="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <Grid MaxWidth="1140" Margin="36,33,36,27">
                <StackPanel x:Name="FocusPage">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Focus session" Margin="0,0,0,23"/>
                    <TextBlock x:Name="FocusStorageMessage" Foreground="#973D25" TextWrapping="Wrap"
                               Margin="0,0,0,13" Visibility="Collapsed"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.52*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border CornerRadius="24" MinHeight="459" Padding="24,25,24,26">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#254C3D" Offset="0"/>
                                    <GradientStop Color="#142F27" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel VerticalAlignment="Center">
                                <Border Background="#254637" BorderBrush="#4A6A5B" BorderThickness="1"
                                        Padding="3" CornerRadius="14" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="FocusMode" Content="Focus" Style="{StaticResource Mode}" Margin="0,0,3,0"/>
                                        <Button x:Name="BreakMode" Content="Break" Style="{StaticResource Mode}"/>
                                    </StackPanel>
                                </Border>

                                <Grid Width="264" Height="264" Margin="0,22,0,23">
                                    <Ellipse Width="262" Height="262" Stroke="#476657" StrokeThickness="1"/>
                                    <Ellipse Width="236" Height="236" Stroke="#516D60" StrokeThickness="4"/>
                                    <Path x:Name="ProgressArc" Stroke="{StaticResource Mint}" StrokeThickness="4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="TimerModeText" Foreground="{StaticResource Mint}"
                                                   FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                                        <TextBlock x:Name="ClockText" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="56" Foreground="{StaticResource Cream}"
                                                   TextAlignment="Center" Margin="0,2,0,0"
                                                   AutomationProperties.HelpText="Time remaining"/>
                                        <TextBlock x:Name="ClockStatus" Foreground="{StaticResource SoftWhite}"
                                                   TextAlignment="Center" FontSize="13" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="TimerPrimary" MinWidth="146" MinHeight="45"
                                            Background="{StaticResource Mint}" Foreground="#173728"/>
                                    <Button x:Name="TimerEnd" Content="End session" Margin="9,0,0,0" MinHeight="45"
                                            Style="{StaticResource Secondary}" Foreground="{StaticResource Cream}"
                                            BorderBrush="#658375" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="Focus history is saved on this PC."
                                           Style="{StaticResource Quiet}" FontSize="12" Margin="0,21,0,0"/>
                                <StackPanel>
                                    <TextBlock Text="Session setup" Style="{StaticResource CardTitle}" Margin="0,0,0,24"/>
                                    <TextBlock Text="Session goal" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <TextBox x:Name="GoalInput" Style="{StaticResource Input}" MinHeight="93" Height="93"
                                                 TextWrapping="Wrap" AcceptsReturn="True" MaxLength="240"
                                                 VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False"
                                                 AutomationProperties.Name="Session goal"/>
                                        <TextBlock x:Name="GoalPlaceholder" Text="What are you working on?"
                                                   Style="{StaticResource Quiet}" Foreground="#65796D"
                                                   IsHitTestVisible="False" Margin="13,10,12,0"/>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,25,0,21"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Focus length" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                            <Grid>
                                                <TextBox x:Name="FocusMinutesInput" Style="{StaticResource Input}"
                                                         Padding="12,9,38,9" MaxLength="3" MinHeight="42"
                                                         VerticalContentAlignment="Center"
                                                         AutomationProperties.Name="Focus length in minutes"/>
                                                <TextBlock Text="min" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource Muted}" Margin="0,0,12,0"
                                                           IsHitTestVisible="False"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Break length" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                            <Grid>
                                                <TextBox x:Name="BreakMinutesInput" Style="{StaticResource Input}"
                                                         Padding="12,9,38,9" MaxLength="3" MinHeight="42"
                                                         VerticalContentAlignment="Center"
                                                         AutomationProperties.Name="Break length in minutes"/>
                                                <TextBlock Text="min" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource Muted}" Margin="0,0,12,0"
                                                           IsHitTestVisible="False"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="TimerMessage" TextWrapping="Wrap" Foreground="#973D25"
                                               Margin="0,13,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="ShowcasePage" Visibility="Collapsed">
                    <Grid Margin="0,0,0,23">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Showcase" Margin="0,0,148,0"/>
                        <Button x:Name="OpenScenario" Content="Open JSON…" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Style="{StaticResource Secondary}"/>
                    </Grid>
                    <TextBlock x:Name="ScenarioError" Foreground="#973D25" TextWrapping="Wrap" Margin="0,0,0,14"
                               Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1.15*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Scenario" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="ScenarioPicker" Style="{StaticResource ScenarioSelect}" DisplayMemberPath="Title"
                                          AutomationProperties.Name="Saved showcase scenarios"/>
                                <TextBlock x:Name="ScenarioGoal" Margin="0,16,0,6" TextWrapping="Wrap"
                                           FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ScenarioTerms" Style="{StaticResource Quiet}" FontSize="12"/>
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,17,0,8"/>
                                <ScrollViewer x:Name="TimelineScroll" MaxHeight="314" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="Timeline">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="9,4" CornerRadius="8" Margin="0,1"
                                                        Background="Transparent" x:Name="TimelineRow">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Activity}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13"/>
                                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Duration}" FontSize="12"
                                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Current}" Value="True">
                                                        <Setter TargetName="TimelineRow" Property="Background" Value="{StaticResource Mist}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="23" MinHeight="464">
                            <DockPanel>
                                <TextBlock x:Name="RuleSummary" DockPanel.Dock="Bottom" Style="{StaticResource Quiet}"
                                           FontSize="12" Margin="0,18,0,0"/>
                                <StackPanel>
                                    <Border CornerRadius="15" Background="#234436" Padding="17">
                                        <StackPanel>
                                            <TextBlock Text="Simulated time" Foreground="{StaticResource SoftWhite}" FontSize="13" FontWeight="SemiBold"/>
                                            <Grid Margin="0,5,0,9">
                                                <TextBlock x:Name="ReplayClock" FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="40" Foreground="{StaticResource Cream}"/>
                                                <TextBlock x:Name="StepCount" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                           Margin="0,0,0,7" Foreground="{StaticResource SoftWhite}" FontSize="12"/>
                                            </Grid>
                                            <ProgressBar x:Name="ReplayProgress" Minimum="0" Maximum="100" Height="5"
                                                         Background="#536D61" Foreground="{StaticResource Mint}">
                                                <ProgressBar.Template>
                                                    <ControlTemplate TargetType="ProgressBar">
                                                        <Grid>
                                                            <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}"/>
                                                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                                                    Background="{TemplateBinding Foreground}"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </ProgressBar.Template>
                                            </ProgressBar>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="CueCard" Background="#EEF3EB" CornerRadius="15" Padding="16,13,16,15" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="CueTitle" Style="{StaticResource CardTitle}" FontSize="20" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="CueDetail" Style="{StaticResource Quiet}" Margin="0,5,0,0"/>
                                            <WrapPanel x:Name="CueActions" Margin="0,8,0,0" Visibility="Collapsed">
                                                <Button x:Name="DismissCue" Content="Dismiss" Style="{StaticResource Secondary}"
                                                        MinHeight="34" Padding="10,0" Margin="0,3,5,0"/>
                                                <Button x:Name="SnoozeCue" Content="Snooze" Style="{StaticResource Secondary}"
                                                        MinHeight="34" Padding="10,0" Margin="0,3,5,0"/>
                                                <Button x:Name="CorrectCue" Content="I was on task" Style="{StaticResource Secondary}"
                                                        MinHeight="34" Padding="10,0" Margin="0,3,0,0"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button x:Name="NextStep" Content="Run next step" MinWidth="134"/>
                                        <Button x:Name="ResetReplay" Content="Reset" Style="{StaticResource Secondary}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="HistoryPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="History" Margin="0,0,0,23"/>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="23,18">
                            <StackPanel>
                                <TextBlock Text="Focus logged today" Style="{StaticResource Quiet}" FontSize="13"/>
                                <TextBlock x:Name="FocusToday" FontSize="29" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="23,18">
                            <StackPanel>
                                <TextBlock Text="Completed sessions" Style="{StaticResource Quiet}" FontSize="13"/>
                                <TextBlock x:Name="CompletedSessions" FontSize="29" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <StackPanel x:Name="EmptyHistory" Margin="25,22">
                                <TextBlock Text="No focus sessions yet" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Your time appears here when you end or finish a focus session." Style="{StaticResource Quiet}" Margin="0,7,0,0"/>
                            </StackPanel>
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="22,15" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Goal}" TextWrapping="Wrap" FontWeight="SemiBold" Padding="0,0,12,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{StaticResource Muted}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Date}" Foreground="{StaticResource Muted}"
                                                           VerticalAlignment="Center" TextAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="StorageMessage" Foreground="#973D25" TextWrapping="Wrap" Margin="0,13,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
